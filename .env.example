# Copiar a .env y completar. Nunca subir .env al repositorio.

# Clave de API de Gemini (sugerencia de triage)
GEMINI_API_KEY=

# Billetera del Relayer que firma y paga el anclaje en Polygon Amoy (clave privada, 0x...)
RELAYER_PRIVATE_KEY=

# Nodo RPC de Polygon Amoy (chainId 80002)
POLYGON_RPC_URL=

# Sal secreta para seudonimizar la cédula (SHA-256) antes de enviarla a la cadena
PATIENT_SALT=

# Opcional: por defecto mongodb://127.0.0.1:27017/medichain_thesis
MONGODB_URI=

# Opcional: interfaz de red del servidor. Por defecto 127.0.0.1 (solo el propio equipo).
# 0.0.0.0 lo abre a la red local: usar solo en una red controlada.
HOST=

# Opcional, solo para la prueba de integridad: clave de la cuenta owner del contrato con la que el script
# inicia sesión. Si se deja vacía, usa RELAYER_PRIVATE_KEY.
ADMIN_PRIVATE_KEY=

# Solo para pruebas en desarrollo: habilita la simulación de ataques (PATCH /api/hack/:id).
# Dejar vacío o en false en cualquier despliegue real (RNF-07).
ENABLE_ATTACK_SIMULATION=false
